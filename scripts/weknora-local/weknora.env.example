# Copy to .omx/WeKnora/.env. The start script does this automatically.
# Fill the API keys before importing documents or running model tests.

WEKNORA_VERSION=latest
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN

# Avoid port collision with ai-learning-backend on 8080.
APP_PORT=8090
FRONTEND_PORT=8091
MCP_PORT=8082

# Keep optional observability disabled for local development.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
[REDACTED]

DISABLE_REGISTRATION=false
DB_DRIVER=postgres
RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
STREAM_MANAGER_TYPE=redis
LOCAL_STORAGE_BASE_DIR=/data/files
AUTO_RECOVER_DIRTY=true
ENABLE_GRAPH_RAG=false
WEKNORA_SANDBOX_MODE=disabled

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=[REDACTED]
DB_NAME=WeKnora
REDIS_PASSWORD=[REDACTED]
REDIS_DB=0
REDIS_PREFIX=stream:

TENANT_AES_KEY=weknorarag-api-key-secret-secret
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!
JWT_SECRET=[REDACTED]
CONCURRENCY_POOL_SIZE=2

# Optional local Ollama endpoint. If you install Ollama later, containers can reach it here.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The Agent-RAG upstream only needs a remote embedding model. Final generation
# continues to use the Spring Agent LLM configured by AI_OPENAI_*.
# This verified project profile uses
# gemini-embedding-2-preview through the configured API gateway (3072 dimensions).
EMBEDDING_MODEL_NAME=gemini-embedding-2-preview
EMBEDDING_BASE_URL=https://yunwu.ai/v1
EMBEDDING_API_KEY=[REDACTED]
EMBEDDING_PROVIDER=openai

# Rerank is optional for phase 2. Leave blank unless you have a rerank provider.
RERANK_MODEL_NAME=
RERANK_BASE_URL=
RERANK_API_KEY=
[REDACTED]
