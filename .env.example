# Copy to .env.local; only scripts/competition/start-local.ps1 loads this file automatically.
# Use KEY=value, without quotes, export, $env:, or trailing inline comments.
# Never commit .env.local or real credentials. See docs/CONFIGURATION.md.

# Answer generation: fill all three using one actual non-GPT chat provider.
# Required for Agent/lesson preparation/question generation/RAG answers, not plain text indexing.
AI_GENERATION_BASE_URL=
AI_GENERATION_MODEL=
AI_GENERATION_API_KEY=
AI_GENERATION_TIMEOUT_SECONDS=30

# Planning: leave these UNSET to inherit generation, or fill all three for a separate provider.
# Empty lines here are ignored by start-local.ps1; an explicitly empty OS property may block fallback.
AI_PLANNING_BASE_URL=
AI_PLANNING_MODEL=
AI_PLANNING_API_KEY=
AI_PLANNING_TIMEOUT_SECONDS=10

# Explicit shared SiliconFlow credential for Embedding and OCR only.
# Per-role API_KEY values override this alias. This never fills the generation/planning roles.
SILICONFLOW_API_KEY=

# K03 semantic retrieval. Without any resolved Embedding key, retrieval falls back explicitly to keywords.
# Keyword-only mode does not pass semantic acceptance.
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_RETRIEVAL_RRF_K=1
RAG_RETRIEVAL_CANDIDATE_LIMIT=20

# K02 scanning/math/figure OCR; implemented adapter, not a separate WeKnora service.
OCR_BASE_URL=https://api.siliconflow.cn/v1
OCR_MODEL=deepseek-ai/DeepSeek-OCR
OCR_API_KEY=
OCR_TIMEOUT_SECONDS=60

# Default figure reading uses OCR observations followed by the text answer model.
# Only enable direct images with an explicitly configured non-GPT answer model supporting images.
RAG_CHAT_ATTACH_IMAGES=false
RAG_VISUAL_TIMEOUT_MS=15000

# Normal MySQL profile only. contest-demo overrides its datasource and RAG file path.
DB_URL=jdbc:mysql://localhost:3306/ai_academy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
# Required for MySQL: at least 32 UTF-8 bytes from a private random value.
# Empty in local contest-demo uses the synthetic demonstration secret; do not expose that profile.
JWT_SECRET=
RAG_STORAGE_PATH=./data/native-rag

# Legacy compatibility only; fresh collaborators should use AI_GENERATION_* above.
# Precedence per field: AI_GENERATION_* > AI_OPENAI_* > BASE_URL/API_KEY.
# There is no generic model default and no GPT runtime fallback.
AI_OPENAI_BASE_URL=
AI_OPENAI_MODEL=
AI_OPENAI_API_KEY=
BASE_URL=
API_KEY=
