# Copy to .env.local for scripts/competition/start-local.ps1 only.
# Compose does NOT load .env.local or forward all host model variables.
# Uncomment only the settings you deliberately manage through the environment.
# Use KEY=value without quotes, export, $env:, or trailing inline comments.
# Never commit private files or real credentials. See docs/CONFIGURATION.md.
#
# Fresh web setup needs no model or legacy DB_* variables. All models can be skipped.
# Explicit role environment fields override private revisions and are locked in the UI.
# Keeping this template commented avoids unintended locks and legacy startup detection.
#
# Deployment policy: native Vite example; Docker defaults use port 18080.
# AI_INSTALLATION_TRUSTED_ORIGINS=http://localhost:24678,http://127.0.0.1:24678
# AI_INSTALLATION_DIR=./data/installation
# INSTALLATION_MODEL_HTTP_ALLOWLIST=model.internal,host.docker.internal
# Only when the page and API are served from different origins (the /backend proxy needs none):
# CORS_ALLOWED_ORIGINS=https://learning.example.edu
# Compose reads these only from its host environment or a deliberate --env-file:
# WEB_PORT=18080
# WEB_BIND_ADDRESS=127.0.0.1
#
# Generation: OpenAI-compatible chat protocol. OpenAI/GPT are allowed when compatible.
# No automatic provider/model fallback. Supply a matching endpoint/model/credential.
# AI_GENERATION_ENABLED=true
# AI_GENERATION_BASE_URL=https://YOUR_CHAT_PROVIDER/v1
# AI_GENERATION_MODEL=YOUR_CHAT_MODEL
# AI_GENERATION_API_KEY=
# AI_GENERATION_TIMEOUT_SECONDS=30
# AI_GENERATION_CONTEXT_WINDOW_TOKENS=0
#
# Planning: leave endpoint fields UNSET for generation inheritance, or supply the
# complete independent group. Web settings support explicit whole-group inheritance.
# AI_PLANNING_ENABLED=true
# AI_PLANNING_BASE_URL=https://YOUR_PLANNING_PROVIDER/v1
# AI_PLANNING_MODEL=YOUR_PLANNING_MODEL
# AI_PLANNING_API_KEY=
# AI_PLANNING_TIMEOUT_SECONDS=10
#
# Embedding uses its own implemented protocol adapter; never borrows a chat key.
# Keyword-only retrieval does not pass semantic quality acceptance.
# RAG_EMBEDDING_ENABLED=true
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_TIMEOUT_SECONDS=30
# RAG_RETRIEVAL_RRF_K=1
# RAG_RETRIEVAL_CANDIDATE_LIMIT=20
#
# OCR uses its own adapter; not a separate WeKnora service.
# OCR_ENABLED=true
# OCR_BASE_URL=https://api.siliconflow.cn/v1
# OCR_MODEL=deepseek-ai/DeepSeek-OCR
# OCR_API_KEY=
# OCR_TIMEOUT_SECONDS=60
# Explicit shared compatibility credential for Embedding/OCR only:
# SILICONFLOW_API_KEY=
#
# Enable direct images only with an explicitly configured image-capable answer model.
# RAG_CHAT_ATTACH_IMAGES=false
# RAG_VISUAL_TIMEOUT_MS=15000
#
# Legacy MySQL environment mode ONLY. Do not enable for fresh web setup.
# contest-demo uses its isolated H2 datasource and RAG path.
# DB_URL=jdbc:mysql://localhost:3306/ai_academy?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USERNAME=YOUR_DATABASE_USER
# DB_PASSWORD=
# Legacy MySQL requires a private random JWT value of at least 32 UTF-8 bytes.
# Web installation generates its JWT internally; H2 demo has a synthetic local value.
# JWT_SECRET=
# RAG_STORAGE_PATH=./data/native-rag
# UPLOAD_DIR=uploads
#
# Legacy aliases: explicit role env > private instance file > aliases/defaults.
# AI_OPENAI_BASE_URL=
# AI_OPENAI_MODEL=
# AI_OPENAI_API_KEY=
# BASE_URL=
# API_KEY=
