# Logs
logs/
*.log
*.bak
~$*
*.inspect.ndjson
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java
target/
*.class

# Node
node_modules/
dist/
dist-ssr/
test-results/
playwright-report/
# Local Playwright run outputs (screenshots, traces, reports).
/ai-learning-frontend/*-results/
/ai-learning-frontend/.codex-*/
/ai-learning-frontend/route-matrix-report.json

# Python
__pycache__/
*.pyc

# Local settings
.env
.env.*
!.env.example
*.local
.codex_tmp/
**/data/native-rag/
**/data/contest-demo/
**/data/installation/
ai-learning-backend/uploads/
/uploads/
.omx/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.apifox-run/

# Reviewed, redacted development evidence belongs in the collaboration repository.
!docs/competition/**/logs/
!docs/competition/**/logs/**/
!docs/competition/**/*.log

# Browser profiles are machine-local credentials/caches, never project assets.
**/chrome-profile*/

# Local instance dumps may contain user identities and learning records.
/database/ai_academy_export.sql
/database/ai_academy_content_seed.sql

# Keep raw browser traces and isolated test databases local; publish sanitized reports.
/docs/competition/development/agent-records/**/trace.zip
/docs/competition/development/agent-records/**/isolated-data/

# Office conversion profiles are machine-local caches.
**/lo_profile*/

# Showcase site: build cache and judge credentials fetched from the demo server.
ai-learning-site/.vitepress/cache/
ai-learning-site/.vitepress/demo-accounts.local.json
